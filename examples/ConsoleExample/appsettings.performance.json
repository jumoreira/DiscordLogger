{
  "DiscordLogger": {
    "WebhookUrl": "YOUR_WEBHOOK_URL_HERE",
    "Username": "Production Logger",
    "AvatarUrl": null,
    "MinimumLevel": "Information",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "EnableScopes": true,
    "EnablePriorityQueue": true,
    "EnableHttpClientPooling": true,
    "GracefulShutdownTimeoutSeconds": 5,
    
    "Batching": {
      "Enabled": true,
      "MaxBatchSize": 10,
      "FlushIntervalSeconds": 2,
      "MaxQueueSize": 1000
    },
    
    "Buffering": {
      "Enabled": true,
      "BufferCapacity": 500,
      "FlushStrategy": "Auto",
      "AutoFlushIntervalSeconds": 10,
      "FlushThreshold": 50,
      "OverflowBehavior": "DropOldest",
      "EnablePersistence": false,
      "PersistenceDirectory": null,
      "MaxPersistenceFileSizeMB": 10,
      "PersistenceRetentionHours": 24
    },
    
    "FileAttachment": {
      "Enabled": true,
      "MessageThreshold": 1900,
      "PreviewLength": 500,
      "FilePrefix": "log",
      "IncludeTimestamp": true,
      "PreviewFormat": "**Preview** (Total: {totalLength} chars - Ver anexo {fileName}):\n```\n{preview}\n```"
    },
    
    "Filters": {
      "IncludeCategories": [],
      "ExcludeCategories": [
        "Microsoft.AspNetCore.Hosting.Diagnostics",
        "Microsoft.AspNetCore.Mvc.Infrastructure",
        "System.Net.Http.HttpClient"
      ],
      "IncludeEventIds": [],
      "ExcludeEventIds": [],
      "MessagePatterns": [
        "^Health check",
        "^Request starting HTTP"
      ],
      "MessagePatternsAsWhitelist": false,
      "EnabledLevels": {
        "Debug": false,
        "Information": true,
        "Warning": true,
        "Error": true,
        "Critical": true
      }
    }
  }
}
